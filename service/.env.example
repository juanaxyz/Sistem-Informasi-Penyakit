# --- RAG / chat (Gemini + Supabase) ---
GEMINI_API_KEY=
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_KEY=

# --- Analisis citra / prediksi ---
# "1" = hasil fallback deterministik bila file .onnx belum ada (mode develop).
# Matikan (0) bila model asli sudah terpasang.
ALLOW_STUB=1

# Folder tempat file .onnx diletakkan (relatif terhadap folder service).
MODELS_DIR=models

# Dapat diubah bila file .onnx diletakkan di path lain.
# MODEL_ONNX_DENSENET121=models/densenet121.onnx
# MODEL_ONNX_RESNET50=models/resnet50.onnx
# MODEL_ONNX_EFFICIENTNETB0=models/efficientnetb0.onnx

# Port uvicorn (default 8000).
# SERVICE_PORT=8000