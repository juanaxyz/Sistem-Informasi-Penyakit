# --- RAG / chat ---
# Gemini hanya dipakai untuk MENJAWAB. Embedding berjalan lokal via
# sentence-transformers (model diunduh otomatis ke cache HuggingFace).
GEMINI_API_KEY=

# Model embedding lokal. Dimensi harus cocok dengan VECTOR(...) di db/schema.sql.
# EMBEDDING_MODEL=LazarusNLP/all-indo-e5-small-v4
# EMBEDDING_DIMENSION=384

# Cosine similarity minimal agar chunk dianggap relevan.
# SIMILARITY_THRESHOLD=0.40

# Token bersama untuk endpoint sinkronisasi embedding (POST /api/load-knowledge).
# WAJIB diisi agar tombol admin panel berfungsi. Kosongkan untuk mematikan
# endpoint tersebut. Harus sama dengan RAG_ADMIN_TOKEN di server/.env.
RAG_ADMIN_TOKEN=

# Database yang sama dengan BFF (server/.env). Wajib ekstensi pgvector.
# Jalankan `python scripts/apply_schema.py` sekali untuk membuat tabel
# knowledge_embeddings.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=admin
PGDATABASE=capstone_paru

# Connection pool (opsional).
# PG_POOL_MAX=5
# PG_CONNECT_TIMEOUT=5

# --- Analisis citra / prediksi ---
# "1" = hasil fallback deterministik bila file .onnx belum ada (mode develop).
# Matikan (0) bila model asli sudah terpasang.
ALLOW_STUB=1

# Folder tempat file .onnx diletakkan (relatif terhadap folder service).
MODELS_DIR=models

# Dapat diubah bila file .onnx diletakkan di path lain.
# MODEL_ONNX_DENSENET121=models/densenet121.onnx
# MODEL_ONNX_RESNET50=models/resnet50.onnx
# MODEL_ONNX_EFFICIENTNETB0=models/efficientnetb0.onnx

# Port uvicorn (default 8000).
# SERVICE_PORT=8000
