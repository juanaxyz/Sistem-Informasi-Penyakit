# Supabase — salin nilai dari .env root proyek ini (tanpa prefix VITE_).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Port HTTP server; default 4000
PORT=4000

# Origin yang diizinkan CORS (frontend Vite dev server default 5173).
# Pisahkan dengan koma bila lebih dari satu.
CORS_ORIGIN=http://localhost:5173

# Base URL RAG API (FastAPI). BFF mem-proxy /api/rag/chat ke sini.
RAG_API_URL=http://localhost:8000