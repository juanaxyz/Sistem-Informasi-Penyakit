# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN commit file `.env` ke git (sudah di-ignore).

# Port tempat API berjalan (default 4000)
PORT=4000

# Connection string PostgreSQL.
# Format: postgres://user:password@host:port/nama_database
DATABASE_URL=postgres://user:password@localhost:5432/web_paru_paru
