# --- PostgreSQL lokal ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=capstone_paru
# PGPOOL_MAX=10   # opsional
# PG_CONN_TIMEOUT=5000  # opsional, ms

# Port HTTP server; default 4000
PORT=4000

# development | production
NODE_ENV=development

# Secret JWT untuk sign/verify token. WAJIB diisi (utamanya di production).
JWT_SECRET=

# Origin yang diizinkan CORS (frontend Vite dev server default 5173).
# Pisahkan dengan koma bila lebih dari satu.
CORS_ORIGIN=http://localhost:5173

# Base URL service Python (FastAPI, gabungan RAG + Analisis Citra).
# BFF mem-proxy /api/rag/chat dan memanggil /api/prediksi ke layanan yang sama.
RAG_API_URL=http://localhost:8000

# Override opsional bila analisis citra di-service terpisah.
# Default: ikut RAG_API_URL.
MODEL_API_URL=http://localhost:8000